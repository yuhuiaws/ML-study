{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "Confronted with difficult questions in an interview , the job-hunters mostly will be at a loss about what to do ."}]}, {"role": "assistant", "content": [{"text": "Usually , you cannot prepare for these questions in advance and have to depend on your immediate performance ."}]}, {"role": "user", "content": [{"text": "Still , there are some rules to follow ."}]}, {"role": "assistant", "content": [{"text": "In this case , you should first keep calm and normal to the face ."}]}, {"role": "user", "content": [{"text": "Don't get nervous and freaked out ."}]}, {"role": "assistant", "content": [{"text": "Formulate a satisfactory answer based on your specific situation ."}]}, {"role": "user", "content": [{"text": "There should be neither too much silence nor hasty answers"}]}, {"role": "assistant", "content": [{"text": "Try to show the best of yourself with decent words and manners ."}]}, {"role": "user", "content": [{"text": "Don't be discouraged even when confronted with negative questions"}]}, {"role": "assistant", "content": [{"text": "You should admit your weakness frankly .\nYou must have confidence in yourself ."}]}]}
