{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "How's your job search going ?"}]}, {"role": "assistant", "content": [{"text": "I only started looking for a job a few days ago ."}]}, {"role": "user", "content": [{"text": "have you finished compiling your resume ?"}]}, {"role": "assistant", "content": [{"text": "yes , I was precise with every word in my resume ?"}]}, {"role": "user", "content": [{"text": "that's good . Don't forget to design the format . An attractive format is as important as the content ."}]}, {"role": "assistant", "content": [{"text": "absolutely , I've highlighted all my strengths and the resume is clear and easy to read ."}]}, {"role": "user", "content": [{"text": "good . How about your cover letter ?"}]}, {"role": "assistant", "content": [{"text": "a cover letter ? I've never thought about that . Won't a CV do for my job application ?"}]}, {"role": "user", "content": [{"text": "no , a CV is not enough . You should also attach it with a cover letter . Don't overlook it . You're faced with fierce competition in the job market . If your cover letter cannot stand out in the pile of"}]}, {"role": "assistant", "content": [{"text": "sounds reasonable.Even if I'm the right one for the job , many people are applying for the same vacancy at the same time , so I should try my best to catch the Human Resources manager's attention .\ngot it . I'll start right now ."}]}]}
