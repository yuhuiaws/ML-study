{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "Professor Wang , what is non-tariff barrier ?"}]}, {"role": "assistant", "content": [{"text": "Non-tariff barrier is another mean to restrict imports ."}]}, {"role": "user", "content": [{"text": "Can you give an example ?"}]}, {"role": "assistant", "content": [{"text": "For example , some countries restrict imports by quantitative restriction ."}]}, {"role": "user", "content": [{"text": "Why ?"}]}, {"role": "assistant", "content": [{"text": "This is used to protect local industries or to achieve certain political objectives ."}]}, {"role": "user", "content": [{"text": "Oh , Are there other means ?"}]}, {"role": "assistant", "content": [{"text": "Technical barriers are set for imported goods .\nYes , some countries may use some of the unnecessary health rules to exclude foreign food ."}]}]}
