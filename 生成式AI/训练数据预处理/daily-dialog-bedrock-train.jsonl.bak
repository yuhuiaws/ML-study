{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "No . This time I'll try Chinese wine ."}]}, {"role": "assistant", "content": [{"text": "What about Mao Tai , one of the most famous liquors in China ? It's good indeed . It never goes to the head ."}]}, {"role": "user", "content": [{"text": "Do people here drink a lot of liquors ?"}]}, {"role": "assistant", "content": [{"text": "Some do , some don't . Many people in the North are fond of liquors . I think it has something to do with the climate ."}]}, {"role": "user", "content": [{"text": "Yes , it has . Some Mexicans are crazy . They drink a lot of liquors even on hot days . Have you ever heard of \" Tequila Sauta \" ?"}]}, {"role": "assistant", "content": [{"text": "Yes , it's a very well-known kind of spirits in Mexico . People drink it with salt and lemon ."}]}, {"role": "user", "content": [{"text": "Right . It's very strong , just like alcohol . ( Frank sips Mao Tai . )"}]}, {"role": "assistant", "content": [{"text": "Yes , besides Mao Tai , we have Wu Liang Ye , Fen Jim and so on ."}]}, {"role": "user", "content": [{"text": "They say that Showing wine tastes quite good . What's it ?"}]}, {"role": "assistant", "content": [{"text": "It's rice wine , a kind of still wine , somewhat like Japanese Sake . Showing is a city in China ."}]}, {"role": "user", "content": [{"text": "I see ."}]}, {"role": "assistant", "content": [{"text": "By the way , we also have some good red wine and white wine , such as Great Wall White Wine .\nI'm always at your service ."}]}]}
