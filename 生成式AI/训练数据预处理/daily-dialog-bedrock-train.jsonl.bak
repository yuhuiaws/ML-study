{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "Is your lady beautiful ? Since I came here from the country , I've not seen her close . Tell me , is she beautiful ?"}]}, {"role": "assistant", "content": [{"text": "Thomas , if I could write with the beauty in her eyes , I was born to look in them and know myself ."}]}, {"role": "user", "content": [{"text": "And , her lips ?"}]}, {"role": "assistant", "content": [{"text": "Her lips ? The early morning rose would wither on the branch if it could feel envy ."}]}, {"role": "user", "content": [{"text": "And her voice like a lark's song ?"}]}, {"role": "assistant", "content": [{"text": "Deeper , softer , none of your twittering larks . I would banish nightingales from her garden before they interrupted her song .\nConstantly . Without doubt , and plays the lute . She has a natural ear ."}]}]}
