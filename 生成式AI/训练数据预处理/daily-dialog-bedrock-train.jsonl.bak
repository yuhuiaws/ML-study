{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "I'd like to open a new account ."}]}, {"role": "assistant", "content": [{"text": "have you filled out an application form ?"}]}, {"role": "user", "content": [{"text": "yes . And I've brought some documents along with me , too . Do you need to see my passport ?"}]}, {"role": "assistant", "content": [{"text": "yes . I'll just have my assistant look over these quickly and then we'll move on to the next step . Did you want to open up a checking account and a savings account ?"}]}, {"role": "user", "content": [{"text": "yes . Does the checking account come with a debit card ?"}]}, {"role": "assistant", "content": [{"text": "yes . Actually , both accounts come with cards that you can use in ATM machines , so that you won't have to come in to the bank to make a transaction ."}]}, {"role": "user", "content": [{"text": "that's very convenient ."}]}, {"role": "assistant", "content": [{"text": "it is . Our customers really like it . Do you have any other questions about your new accounts ?"}]}, {"role": "user", "content": [{"text": "yes . What's the maximum amount that you are allowed to have in an overdraft ?"}]}, {"role": "assistant", "content": [{"text": "the maximum is $ 1000 ."}]}, {"role": "user", "content": [{"text": "is there a penalty for having an overdraft ?"}]}, {"role": "assistant", "content": [{"text": "yes , but it's not much . You just have to pay 1 % interest on the amount . It's much lower rate than any of our loans and it's much better than owing money to most credit cards ."}]}, {"role": "user", "content": [{"text": "that's true . Is everything alright with my documents ?"}]}, {"role": "assistant", "content": [{"text": "they're all in order . If you just sign your name here , you'll receive your cards and pin numbers in the mail in about three weeks .\nyou're welcome ."}]}]}
