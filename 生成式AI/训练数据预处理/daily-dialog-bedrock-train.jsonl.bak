{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "Is there anything wrong ?"}]}, {"role": "assistant", "content": [{"text": "I ’ m worried about my daughter . She can ’ t decide about college ."}]}, {"role": "user", "content": [{"text": "Don ’ t worry . That ’ s just a part of being a teenager ."}]}, {"role": "assistant", "content": [{"text": "I don ’ t mind that . But she disagrees with me about everything ."}]}, {"role": "user", "content": [{"text": "You should encourage her to make up her mind by herself . You shouldn ’ t affect her decision ."}]}, {"role": "assistant", "content": [{"text": "But I just want to give her some tips ."}]}, {"role": "user", "content": [{"text": "Oh , she can make her own decisions ."}]}, {"role": "assistant", "content": [{"text": "I guess you are right .\nI hope so ."}]}]}
