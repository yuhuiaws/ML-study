{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "You ’ re a wonderful person , Kathleen ."}]}, {"role": "assistant", "content": [{"text": "So are you ."}]}, {"role": "user", "content": [{"text": "And I ’ m so honored that you would want to be with me because you would never be with anyone who wasn ’ t truly worthy ."}]}, {"role": "assistant", "content": [{"text": "I feel exactly the same way as you ."}]}, {"role": "user", "content": [{"text": "Don ’ t , don ’ t , don ’ t , don ’ t say that . That , that makes it worse ."}]}, {"role": "assistant", "content": [{"text": "What ? You don ’ t love me ? Me , either ."}]}, {"role": "user", "content": [{"text": "You don ’ t love me ?"}]}, {"role": "assistant", "content": [{"text": "No .\nI know , I know . Well , is there some , is there someone else ? Oh , that woman on television , Sydney Ann ."}]}]}
