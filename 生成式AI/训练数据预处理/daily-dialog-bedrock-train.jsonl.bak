{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "How was your trip to Brazil ? Did you learn anything ?"}]}, {"role": "assistant", "content": [{"text": "I had no idea how seriously that country takes soccer !"}]}, {"role": "user", "content": [{"text": "Tell me about it ."}]}, {"role": "assistant", "content": [{"text": "Okay . In the middle of their streets there are parks , big soccer fields as far as you can see ."}]}, {"role": "user", "content": [{"text": "Really ?"}]}, {"role": "assistant", "content": [{"text": "That's not all . They use them ! Every night men , women , children all out there till 3 and 4 a . m .\nI don't know how they function the next day ! It's like they eat and breathe soccer !"}]}]}
