e": "user", "content": [{"text": "How about doing it this way ? You increase your quantity to 8,000 dozen and I'll give you a l0 % reduction ."}]}, {"role": "assistant", "content": [{"text": "8000 would be too large a figure to be used for a trial .\nOk . Let's call it a deal ."}]}]}
