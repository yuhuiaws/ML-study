nt": [{"text": "I tried it a couple times . But I don't like it . I like alcohol better.Don ' t worry about them , though . If you don't want to smoke pot , you don't have to ."}]}, {"role": "assistant", "content": [{"text": "I don't want to ."}]}, {"role": "user", "content": [{"text": "That's alright . But you really should have another drink.People will probably start dancing soon ."}]}, {"role": "assistant", "content": [{"text": "I don't know if I can drink more . I already had two drinks ."}]}, {"role": "user", "content": [{"text": "You had two drinks at nine o'clock . C'mon , Ann , you are in an American university now ! You have to learn how to drink ."}]}, {"role": "assistant", "content": [{"text": "I thought a university was for studying .\nAlright . I'll have another drink ."}]}]}
