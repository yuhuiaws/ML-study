{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "What do you base our grades on ?"}]}, {"role": "assistant", "content": [{"text": "All of your coursework is important , including everything from attendance and homework to all of your test results for the semester ."}]}, {"role": "user", "content": [{"text": "Does the final count the most ?"}]}, {"role": "assistant", "content": [{"text": "All of it is important ; please just do your best at all times ."}]}, {"role": "user", "content": [{"text": "How do you total our scores ?"}]}, {"role": "assistant", "content": [{"text": "The final and mid-term are twenty percent each ; homework , attendance , and quizzes are the rest ."}]}, {"role": "user", "content": [{"text": "What if we are out sick ?"}]}, {"role": "assistant", "content": [{"text": "Make sure you contact me as I only allow one unexcused absence .\nYour grade will not be a surprise ; you will know what you need to work on ."}]}]}
