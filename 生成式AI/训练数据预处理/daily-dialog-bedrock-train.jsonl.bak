{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "Do you have to pay to join ?"}]}, {"role": "assistant", "content": [{"text": "Yes , membership fees vary depending on the club but usually they run into tens of thousands of dollars ."}]}, {"role": "user", "content": [{"text": "Wow , that much ? Don't they have any public courses ?"}]}, {"role": "assistant", "content": [{"text": "Very few , unfortunately ."}]}, {"role": "user", "content": [{"text": "How was your game today ?"}]}, {"role": "assistant", "content": [{"text": "Extremely good . I shot a 78 , including 5 birdies !"}]}, {"role": "user", "content": [{"text": "Congratulations ! What's your normal handicap ?"}]}, {"role": "assistant", "content": [{"text": "Ten . How did your game go ?\nMaybe you can correct it by going to a driving range before you play again ."}]}]}
