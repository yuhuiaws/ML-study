{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "It is quite important to be a good listener in the interview ."}]}, {"role": "assistant", "content": [{"text": "Listening carefully can show you understand and respect the speaker ."}]}, {"role": "user", "content": [{"text": "It can show your good attainment as well ."}]}, {"role": "assistant", "content": [{"text": "Besides , you can pick up some helpful information from the talk ."}]}, {"role": "user", "content": [{"text": "First of all , you should keep proper posture and make eye contact with the speaker with a smile ."}]}, {"role": "assistant", "content": [{"text": "To show that you have understood what is said , you can nod or ask simple questions at the right time ."}]}, {"role": "user", "content": [{"text": "And your statement should be clear and brief to the point ."}]}, {"role": "assistant", "content": [{"text": "Never should you interrupt on a unfamiliar topic ."}]}, {"role": "user", "content": [{"text": "Sure , in order not to leave a bad impression on the interviewer ."}]}, {"role": "assistant", "content": [{"text": "Additionally , don't show any impatience to a repeated topic .\nIn a word , any impolite behavior should be avoided in the listening ."}]}]}
