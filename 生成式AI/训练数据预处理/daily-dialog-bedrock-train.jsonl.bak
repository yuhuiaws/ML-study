{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "The Blacks got divorced ."}]}, {"role": "assistant", "content": [{"text": "Really ? Why ?"}]}, {"role": "user", "content": [{"text": "Mr . Black has been getting a little on the side ."}]}, {"role": "assistant", "content": [{"text": "Really ? I am surprised . He doesn't look like a guy who'd ever cheat on his wife , does he ?"}]}, {"role": "user", "content": [{"text": "No , he doesn't . Anyway , his wife found out that he has been two-timing for a long time ."}]}, {"role": "assistant", "content": [{"text": "Well , I am really surprised . By the way , have you done anything behind my back ?\nI like that joke , but I hope it's true ."}]}]}
