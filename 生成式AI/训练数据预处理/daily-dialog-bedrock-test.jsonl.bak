{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "Yeah , yeah , we ’ re here because we feel this is an injustice ! The financial irresponsibility of big business has to stop ! We ’ re there to show the government that we don ’ t like the way that they ’ re spending our tax dollars !"}]}, {"role": "assistant", "content": [{"text": "Sir but what exactly is making everyone so angry ?"}]}, {"role": "user", "content": [{"text": "It ’ s an absolute outrage , Sarah , the US government wants to give 25 billion dollars of taxpayers ’ money to the auto industry . These are companies that have been mismanaged and are now nearly bankrupt ."}]}, {"role": "assistant", "content": [{"text": "I see . But , many supporters of the bailout argue that it could help save the jobs of millions of hardworking Americans .\nGood point . This is Sarah O ’ Connell reporting live from Washington D . C . , back to you , Tom ."}]}]}
