{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "Excuse me , I'm a little lost . Which bus do I take to get to Shi Da ?"}]}, {"role": "assistant", "content": [{"text": "Let's see . From here , you have to take the 278bus ."}]}, {"role": "user", "content": [{"text": "Oh ok , where do I get off ?"}]}, {"role": "assistant", "content": [{"text": "You should get off at the first Shi Da stop ."}]}, {"role": "user", "content": [{"text": "Ok , thanks ..."}]}, {"role": "assistant", "content": [{"text": "You're new at this , huh ?"}]}, {"role": "user", "content": [{"text": "No , is it difficult ?"}]}, {"role": "assistant", "content": [{"text": "No , it's quite simple . When you get on , just ask the bus driver when to pay the fare and where you want to get off ."}]}, {"role": "user", "content": [{"text": "How much does it cost ?"}]}, {"role": "assistant", "content": [{"text": "Only 15 NT per section . Oh look , that is your bus .\nDon't mention it ."}]}]}
