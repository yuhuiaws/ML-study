{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "Do you speak only English in the class , or does your teacher explain everything to you in Spanish ?"}]}, {"role": "assistant", "content": [{"text": "Oh , we never speak Spanish in class ! Miss.Parker speaks to us only in English ."}]}, {"role": "user", "content": [{"text": "I suppose she's right.Does she speak English very slowly ?"}]}, {"role": "assistant", "content": [{"text": "Not always.Sometimes we don't understand her.Then she has to repeat what she said ."}]}, {"role": "user", "content": [{"text": "It must be interesting to study English ."}]}, {"role": "assistant", "content": [{"text": "Mario and I are the best students in the class.Miss.Parker says that my pronunciation is very good .\nSometimes it's difficult.Some words look different from the way one pronounces them ."}]}]}
