{"schemaVersion": "bedrock-conversation-2024", "system": [{"text": "You are a helpful conversational assistant. Engage in natural, friendly dialogue."}], "messages": [{"role": "user", "content": [{"text": "Brian , a company called me for an interview ."}]}, {"role": "assistant", "content": [{"text": "That's great ! You need to prepare for it ."}]}, {"role": "user", "content": [{"text": "How ?"}]}, {"role": "assistant", "content": [{"text": "Get your hair done at a good hair saloon . Tell them you are going for a job interview ."}]}, {"role": "user", "content": [{"text": "Okay ."}]}, {"role": "assistant", "content": [{"text": "Buy an expensive suit ."}]}, {"role": "user", "content": [{"text": "How expensive ?"}]}, {"role": "assistant", "content": [{"text": "The more expensive , the better ."}]}, {"role": "user", "content": [{"text": "I can ’ t afford too expensive , maybe $ 50 to $ 70 ?"}]}, {"role": "assistant", "content": [{"text": "That'll do it . The best way is to find the dressing color code of the company ."}]}, {"role": "user", "content": [{"text": "How ?"}]}, {"role": "assistant", "content": [{"text": "If you know somebody at the company , ask them . If not , dark color will be fine ."}]}, {"role": "user", "content": [{"text": "Is a white blouse okay ?"}]}, {"role": "assistant", "content": [{"text": "Yeah , fine . And dressing shoes ."}]}, {"role": "user", "content": [{"text": "Black ?"}]}, {"role": "assistant", "content": [{"text": "Black is good ."}]}, {"role": "user", "content": [{"text": "White pantyhose ?"}]}, {"role": "assistant", "content": [{"text": "No . Dark or skin colored ."}]}, {"role": "user", "content": [{"text": "Jewelry ?"}]}, {"role": "assistant", "content": [{"text": "Necklace , ring , and earrings are all fine . But don ’ t wear too many pieces of jewelry ."}]}, {"role": "user", "content": [{"text": "How about make up ?"}]}, {"role": "assistant", "content": [{"text": "Not much make up .\nYes , some . But be aware that different people may